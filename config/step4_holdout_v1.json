{
  "panel_path": "data/interim/step1_firm_quarter_panel.parquet",
  "ccm_link_path": "data/raw/crsp/compustat_crsp_link.csv",
  "interim_root": "data/interim/step4_holdout_v1/base",
  "output_root": "output/step4_holdout_v1",
  "selection": {
    "candidate_count": 50,
    "formation_years": [2017, 2018, 2019, 2020, 2021],
    "candidates_per_year": 10,
    "minimum_days_to_announcement": 30,
    "maximum_days_to_announcement": 150,
    "maximum_statement_age_days": 450,
    "one_dossier_per_permno": true,
    "selection_seed": "step4-holdout-v1",
    "required_features": [
      "log_market_equity_lag1",
      "operating_profitability",
      "roa",
      "asset_growth",
      "leverage",
      "cash_holdings",
      "accruals",
      "sales_growth",
      "tangibility",
      "statement_age_days",
      "return_1m_lag1",
      "return_3m_lag1",
      "return_6m_lag1",
      "return_12m_lag1",
      "return_24m_lag1",
      "return_volatility_12m_lag1",
      "analyst_coverage"
    ]
  },
  "dossier": {
    "version": "holdout_v1_tabular_anonymous",
    "round_digits": 4,
    "accounting_features": [
      "operating_profitability",
      "roa",
      "asset_growth",
      "leverage",
      "cash_holdings",
      "accruals",
      "sales_growth",
      "tangibility"
    ],
    "return_features": [
      "return_1m_lag1",
      "return_3m_lag1",
      "return_6m_lag1",
      "return_12m_lag1",
      "return_24m_lag1",
      "return_volatility_12m_lag1"
    ]
  },
  "outcome": {
    "name": "theta_ex_ante",
    "definition": "I/B/E/S next_sue robustly centered and scaled using only distinct announcement outcomes strictly before each formation date; values are clipped at 8 robust scale units before standardization.",
    "minimum_preformation_history": 100
  },
  "holdout": {
    "dossier_id_prefix": "H",
    "source_rule": "All eligible 2017--2021 observations are ranked by a fixed hash before any LLM call or outcome use. Ten distinct PERMNOs are selected per formation year, balancing broad industry exposure.",
    "public_manifest_fields": [
      "dossier_id",
      "formation_year",
      "industry_bucket",
      "size_bucket",
      "financial_statement_age_months",
      "days_to_next_announcement"
    ]
  }
}
